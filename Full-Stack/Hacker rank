function processData(input) {

    input = input.trim().split("\n");
    let i = 0;

    function sum(arr) {
        let income = 0, expense = 0;

        arr.forEach(t => {
            if (t.amount > 0) income += t.amount;
            else expense += Math.abs(t.amount);
        });

        return { income: income, expense: expense };
    }

    function handleSubmit(text, amount, arr) {
        if (text === "" || amount === 0) return arr;

        let maxId = 0;
        arr.forEach(t => {
            if (t.id > maxId) maxId = t.id;
        });

        let newT = {
            id: maxId + 1,
            text: text,
            amount: amount
        };

        return arr.concat(newT);
    }

    function renderTransactions(arr) {
        return arr.map(t => t.text + " : " + t.amount);
    }

    function deleteTransaction(arr, id) {
        return arr.filter(t => t.id != id);
    }

    let n = parseInt(input[i++]);
    let transactions = [];

    for (let j = 0; j < n; j++) {
        let parts = input[i++].split(" ");
        transactions.push({
            id: j + 1,
            text: parts[0],
            amount: Number(parts[1])
        });
    }

    let newText = input[i++];
    let newAmount = Number(input[i++]);
    let deleteId = Number(input[i++]);

    transactions = handleSubmit(newText, newAmount, transactions);
    transactions = deleteTransaction(transactions, deleteId);

    let totals = sum(transactions);
    let renderedList = renderTransactions(transactions);

    console.log(JSON.stringify({
        transactions: transactions,
        totals: totals,
        renderedList: renderedList
    }));
}

process.stdin.resume();
process.stdin.setEncoding("ascii");
_input = "";
process.stdin.on("data", function (input) {
    _input += input;
});

process.stdin.on("end", function () {
    processData(_input);
});
